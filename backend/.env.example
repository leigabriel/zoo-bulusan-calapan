# DEVELOPMENT
PORT=5000
NODE_ENV=development

# RATE LIMITING
# Number of reverse proxies in front of this process. Default 1 (single proxy:
# nginx, Render, Vercel, Fly). Set to 0 if the app is exposed directly, otherwise
# a client can spoof X-Forwarded-For and bypass IP-based limits.
TRUST_PROXY_HOPS=1
# Emergency escape hatch: set to false (or RATE_LIMIT_DISABLED=true) to turn off
# every limiter. Limiters are always off when NODE_ENV=test.
# RATE_LIMIT_ENABLED=true

# Localhost Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bulusanzoocalapandatabase

# JWT
# REQUIRED. No default exists on purpose: the server refuses to start if this is
# missing, shorter than 32 characters, or set to a known placeholder.
# Generate with:  node scripts/generate-secrets.js
JWT_SECRET=
JWT_EXPIRE=7d

# Optional. Leave blank to derive a purpose-scoped key from JWT_SECRET (HKDF),
# which gives you key separation without managing extra secrets.
# Set these only if you need to rotate them independently.
# PUBLIC_ID_SECRET=
# RESERVATION_QR_SECRET=

# URLs
# PRODUCTION VALUES (set these in the deployed environment):
#   CORS_ORIGIN=https://bulusanzoo.com
#   FRONTEND_URL=https://bulusanzoo.com
#   BACKEND_URL=https://service.bulusanzoo.com
#   GOOGLE_CALLBACK_URL=https://service.bulusanzoo.com/auth/google/callback
#
# CORS fails closed: if the deployed frontend origin is missing from the
# allow-list, the live site cannot call the API and every request is rejected.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Optional emergency opt-out. Accepts every origin. Never set in production.
# ALLOW_ANY_ORIGIN=false

# Email verification, password reset and notifications - sent through Brevo's
# transactional HTTP API, so mail is delivered by Brevo and never relayed from
# this server (Gmail's SMTP rejects datacenter IPs such as Render's).
# BREVO_API_KEY: Brevo > SMTP & API > API Keys > Generate a new API key
# BREVO_SENDER_EMAIL: an address already verified as a sender in Brevo
# (SMTP is only used when these are absent; set all four to use it instead.)
BREVO_API_KEY=xkeysib-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@your-verified-domain.com
BREVO_SENDER_NAME=Bulisan Zoo

# Fallback SMTP transport, used only when BREVO_API_KEY / BREVO_SENDER_EMAIL are unset
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# PayMongo event GCash payments
# Use the test key while developing, and configure the webhook endpoint:
# https://your-api-host/api/payments/paymongo/webhook
PAYMONGO_SECRET_KEY=sk_test_your-paymongo-secret-key
PAYMONGO_WEBHOOK_SECRET=whsk_your-paymongo-webhook-secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# AI
GEMINI_API_KEY=your-gemini-api-key

# Cloudinary (Cloud Image Storage)
# Get your credentials from https://cloudinary.com/console
# If not configured, uploads will fall back to local storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# PRODUCTION
# PORT=10000
# NODE_ENV=production
# DB_HOST=your-db-host.provider.com
# DB_PORT=3306
# DB_USER=your_prod_user
# DB_PASSWORD=your_prod_password
# DB_NAME=your_prod_database
# DB_SSL_REJECT_UNAUTHORIZED=false
# CORS_ORIGIN=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# BACKEND_URL=https://your-api.onrender.com
# GOOGLE_CALLBACK_URL=https://your-api.onrender.com/auth/google/callback
